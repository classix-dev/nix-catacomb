services:
  cfg-db:        { environment: { POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}" } }
  cgw-db:        { environment: { POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}" } }
  txs-db:        { environment: { POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}" } }
  events-db:     { environment: { POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}" } }

  # RabbitMQ 4.x disables `transient_nonexcl_queues` which Celery's default
  # queue declaration relies on. Pin to 3.13 until upstream celery updates.
  txs-rabbitmq:     { image: "rabbitmq:3.13-alpine" }
  general-rabbitmq: { image: "rabbitmq:3.13-alpine" }

  cfg-web:
    environment:
      SECRET_KEY: "${DJANGO_SECRET}"
      DJANGO_SUPERUSER_PASSWORD: "${DJANGO_SUPERUSER_PASSWORD}"
      DJANGO_SUPERUSER_EMAIL: "admin@@CATACOMB_DOMAIN@"
      CGW_AUTH_TOKEN: "${CGW_AUTH_TOKEN}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
      CSRF_TRUSTED_ORIGINS: "https://@CATACOMB_DOMAIN@"

  txs-web:
    environment:
      DJANGO_SECRET_KEY: "${DJANGO_SECRET}"
      DATABASE_URL: "psql://postgres:${POSTGRES_PASSWORD}@txs-db:5432/postgres"
      CSRF_TRUSTED_ORIGINS: "https://@CATACOMB_DOMAIN@"

  txs-worker-indexer: &txs-worker-overrides
    environment:
      DJANGO_SECRET_KEY: "${DJANGO_SECRET}"
      DATABASE_URL: "psql://postgres:${POSTGRES_PASSWORD}@txs-db:5432/postgres"

  txs-worker-contracts-tokens: *txs-worker-overrides
  txs-worker-notifications-webhooks: *txs-worker-overrides
  txs-scheduler: *txs-worker-overrides

  events-web:
    environment:
      DATABASE_URL: "psql://postgres:${POSTGRES_PASSWORD}@events-db:5432/postgres"

  cgw-web:
    environment:
      AUTH_TOKEN: "${CGW_AUTH_TOKEN}"
      AUTH_POST_LOGIN_REDIRECT_URI: "https://@CATACOMB_DOMAIN@/"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"

  # The upstream UI is replaced by a Nix-built static export served from
  # the host nginx (see hosts/catacomb/ui.nix). The `ui:` service is kept
  # only as a stub on :8080 — internal nginx resolves the `ui` hostname
  # at startup, so removing it would break the whole stack. Returns 410
  # Gone to make stray internal hits visible. Reuses `nginx:alpine` (the
  # internal nginx already pulls this image).
  ui:
    image: nginx:alpine
    entrypoint: [ "sh", "-c" ]
    command:
      - |
        cat >/etc/nginx/conf.d/default.conf <<EOF
        server { listen 8080; location / { return 410 "ui served from host nginx\n"; } }
        EOF
        exec nginx -g 'daemon off;'
